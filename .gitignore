# Gitignore for Groww Lens

# Node / Frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.env.local
frontend/.env.*.local
*.tsbuildinfo
next-env.d.ts

# Python / Backend
backend/venv/
backend/.venv/
backend/__pycache__/
backend/*/__pycache__/
