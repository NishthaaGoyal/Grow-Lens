backend/*/*/*/__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.env
*.env
backend/.env
.pytest_cache/

# Database
*.sqlite3
*.db

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
