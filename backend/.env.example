# ─────────────────────────────────────────────────────────────
# Groww Lens — Environment Variables
# ─────────────────────────────────────────────────────────────

# Database Connection:
# To connect to Supabase:
# Option A (Direct Connection - recommended for standard backends):
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# Option B (Transaction Pooler - port 6543 / PgBouncer / Supavisor):
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# Option C (Local SQLite for zero-config offline dev):
DATABASE_URL=sqlite+aiosqlite:///./groww_lens.db

# Supabase API Credentials (from Project Settings -> API)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Redis (falls back to in-memory if Redis is not running)
REDIS_URL=redis://localhost:6379/0

# AI & News External APIs
GEMINI_API_KEY=your-gemini-api-key
NEWS_API_KEY=
FINNHUB_API_KEY=

# Security & CORS
SECRET_KEY=groww-lens-dev-secret-key-382910382
ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
