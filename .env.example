# ─────────────────────────────────────────────────────────────
# Groww Lens — Root Environment Variables Template
# ─────────────────────────────────────────────────────────────

# Backend Database (Supabase PostgreSQL):
# Option A: Direct Connection (Port 5432)
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# Option B: Transaction Pooler (Port 6543)
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# Option C: Local SQLite (Offline dev)
DATABASE_URL=sqlite+aiosqlite:///./groww_lens.db

# Supabase Project Credentials
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# External AI & News Services
GEMINI_API_KEY=
NEWS_API_KEY=
FINNHUB_API_KEY=

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# Frontend URL for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
